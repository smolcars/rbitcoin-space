# Copy to deploy/.env and fill in. .env is git-ignored; never commit it.
# docs/DEPLOY.md explains each line; docs/CONFIG.md lists every server variable.

# The node: one of mainnet, signet, testnet4, testnet5, regtest, and its P2P port
# (mainnet 8333, signet 38333, testnet4 48333, testnet5 18353, regtest 18444).
# testnet5 needs a newer rbitcoin and a peer (docs/DEPLOY.md, "Testnet 5").
NETWORK=mainnet
P2P_PORT=8333
# Where the P2P port is published on the host, [ip:]port. Defaults to P2P_PORT.
# P2P_PUBLISH=8333

# The server's image: a release, pinned to its version (docs/DEPLOY.md#upgrading). Unset, compose
# builds the image from this checkout instead.
# SERVER_IMAGE=ghcr.io/smolcars/rbitcoin-space:0.5.0

# The server: the same network's six variables, pointing at the node service.
# The node reads the same user and password from rpc.cookie (docs/DEPLOY.md).
MAINNET_RPC_HOST=node
MAINNET_RPC_PORT=8332
MAINNET_RPC_USER=rbitcoin-space
MAINNET_RPC_PASSWORD=
MAINNET_ESPLORA_URL=/run/esplora/esplora.sock
MAINNET_ELECTRUM_ADDR=node:50001

# Bark VTXO pages (docs/ARK.md): the Bark server VTXOs are looked up on. Unset is off. The server
# connects out to it over HTTPS. Signet's public one is https://ark.signet.2nd.dev.
# MAINNET_BARK_URL=https://ark.second.tech

# Where the server's HTTP port is published on the host, [ip:]port. Keep it on loopback
# behind a reverse proxy that terminates TLS.
# HTTP_PUBLISH=127.0.0.1:8080

# Only once that proxy runs and overwrites the header: the header it writes the client address
# to, and the address its connections arrive from inside the container (the compose network's
# gateway for a proxy on the host). Both or neither; docs/DEPLOY.md shows how to find the address.
# Until then leave both unset, so a client cannot choose its own address.
# TRUSTED_PROXY_HEADER=X-Real-IP
# TRUSTED_PROXIES=172.18.0.1

# The site's public address, for the picture and page address in link previews. Unset, a pasted
# link shows a text card only (docs/CONFIG.md, "Site address").
# SITE_URL=https://explorer.example.com

# Everything else in docs/CONFIG.md goes here too: limits, and BROADCAST_ENABLED=false
# to turn off POST /api/tx, the only write the server makes to the node.
